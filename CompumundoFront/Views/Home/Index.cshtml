@{ ViewData["Title"] = "Tecnología para todos"; }
<section class="hero"><div class="container hero-content"><div><p class="eyebrow">TECNOLOGÍA A TU MEDIDA</p><h1>Todo para armar<br />tu mejor <span>setup.</span></h1><p class="hero-text">Componentes, periféricos y equipos para estudiar, trabajar o jugar.</p><a class="primary-button" href="#productos">Ver productos</a></div><div class="hero-illustration" aria-hidden="true"><div class="screen"><span>&lt;/&gt;</span></div><div class="keyboard"></div><div class="mouse"></div></div></div></section>
<section class="benefits"><div class="container benefits-grid"><article><span>🚚</span><div><strong>Envíos a todo el país</strong><small>Recibí tu compra donde estés.</small></div></article><article><span>💳</span><div><strong>Pagá como prefieras</strong><small>Opciones simples y seguras.</small></div></article><article><span>🛠️</span><div><strong>Te ayudamos a elegir</strong><small>Encontrá lo que necesitás.</small></div></article></div></section>
<section class="catalog-section" id="productos"><div class="container"><div class="section-heading"><div><p class="eyebrow">CATÁLOGO</p><h2>Productos destacados</h2></div><label class="search-box"><span>⌕</span><input id="product-search" type="search" placeholder="Buscar un producto" aria-label="Buscar productos" /></label></div><div id="products-status" class="products-status">Cargando productos...</div><div id="products-grid" class="products-grid" aria-live="polite"></div></div></section>
<section class="prebuilt-section" id="prearmadas"><div class="container"><div class="section-heading"><div><p class="eyebrow">LISTAS PARA USAR</p><h2>PCs prearmadas</h2></div></div><div id="pcs-status" class="products-status">Cargando equipos...</div><div id="pcs-grid" class="products-grid"></div></div></section>
<section class="build-section" id="armar-pc"><div class="container build-content"><div class="build-icon" aria-hidden="true">🖥️</div><div><p class="eyebrow">EQUIPOS A MEDIDA</p><h2>¿No sabés por dónde empezar?</h2><p>Contanos para qué vas a usar tu computadora y te ayudamos a encontrar los componentes indicados.</p></div><a class="secondary-button" href="mailto:ventas@compumundo.com">Consultar</a></div></section>
<section class="about-section" id="nosotros"><div class="container about-content"><div><p class="eyebrow">SOBRE COMPUMUNDO</p><h2>La tecnología no tiene por qué ser complicada.</h2></div><p>Somos un equipo que te acompaña a elegir componentes y equipos según lo que realmente necesitás. Buscamos que comprar tu próxima PC sea claro, simple y seguro.</p></div></section>
<div class="modal fade" id="product-modal" tabindex="-1" aria-labelledby="modal-product-name" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content product-modal-content"><button type="button" class="btn-close modal-close" data-bs-dismiss="modal" aria-label="Cerrar"></button><div class="product-modal-icon" id="modal-product-icon">💻</div><div><p class="eyebrow" id="modal-product-brand"></p><h2 id="modal-product-name"></h2><p id="modal-product-description"></p><p class="modal-stock" id="modal-product-stock"></p><div class="modal-bottom"><strong id="modal-product-price"></strong><button class="primary-button" id="modal-add-button" type="button">Agregar al carrito</button></div></div></div></div></div>
<div class="modal fade" id="auth-modal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content form-modal"><div class="modal-header"><div><p class="eyebrow" id="auth-mode-label">TU CUENTA</p><h2 id="auth-title">Ingresar</h2></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><form id="auth-form"><div class="modal-body"><label id="auth-name-field">Nombre<input name="nombre" required></label><label>Correo electrónico<input name="correoElectronico" type="email" required></label><label>Contraseña<input name="contrasenia" type="password" required minlength="4"></label><p class="form-message" id="auth-message"></p></div><div class="modal-footer"><button class="primary-button" type="submit" id="auth-submit">Crear cuenta</button><button class="text-button" type="button" id="auth-toggle">Ya tengo una cuenta</button></div></form></div></div></div>
<div class="modal fade" id="checkout-modal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content form-modal"><div class="modal-header"><div><p class="eyebrow">FINALIZAR COMPRA</p><h2>Datos de entrega</h2></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><form id="checkout-form"><div class="modal-body checkout-grid"><label>Nombre para facturación<input name="facturacion" required></label><label>País<input name="pais" value="Argentina" required></label><label>Provincia<input name="provincia" required></label><label>Ciudad<input name="ciudad" required></label><label>Código postal<input name="codigoPostal" required></label><label>Calle<input name="calle" required></label><label>Número<input name="numeroCalle" required></label><div class="checkout-total">Total a pagar: <strong id="checkout-total"></strong></div><p class="form-message wide" id="checkout-message"></p></div><div class="modal-footer"><button class="primary-button" type="submit">Confirmar pedido</button></div></form></div></div></div>
<div class="modal fade" id="orders-modal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content form-modal"><div class="modal-header"><div><p class="eyebrow">MI CUENTA</p><h2>Mis pedidos</h2></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body" id="orders-content"></div><div class="modal-footer"><button class="text-button" id="logout-button" type="button">Cerrar sesión</button></div></div></div></div>
@section Scripts { <script src="~/js/catalogo.js" asp-append-version="true"></script> }
