@{ ViewData["Title"] = "Tecnología para todos"; }
<section class="hero"><div class="container hero-content"><div><p class="eyebrow">TECNOLOGÍA A TU MEDIDA</p><h1>Todo para armar<br />tu mejor <span>setup.</span></h1><p class="hero-text">Componentes, periféricos y equipos para estudiar, trabajar o jugar.</p><a class="primary-button" href="#productos">Ver productos</a></div><div class="hero-illustration" aria-hidden="true"><div class="screen"><span>&lt;/&gt;</span></div><div class="keyboard"></div><div class="mouse"></div></div></div></section>
<section class="benefits"><div class="container benefits-grid"><article><span>🚚</span><div><strong>Envíos a todo el país</strong><small>Recibí tu compra donde estés.</small></div></article><article><span>💳</span><div><strong>Pagá como prefieras</strong><small>Opciones simples y seguras.</small></div></article><article><span>🛠️</span><div><strong>Te ayudamos a elegir</strong><small>Encontrá lo que necesitás.</small></div></article></div></section>
<section class="catalog-section" id="productos"><div class="container"><div class="section-heading"><div><p class="eyebrow">CATÁLOGO</p><h2>Productos destacados</h2></div><label class="search-box"><span>⌕</span><input id="product-search" type="search" placeholder="Buscar un producto" aria-label="Buscar productos" /></label></div><div id="products-status" class="products-status">Cargando productos...</div><div id="products-grid" class="products-grid" aria-live="polite"></div></div></section>
<section class="build-section" id="armar-pc"><div class="container build-content"><div class="build-icon" aria-hidden="true">🖥️</div><div><p class="eyebrow">EQUIPOS A MEDIDA</p><h2>¿No sabés por dónde empezar?</h2><p>Contanos para qué vas a usar tu computadora y te ayudamos a encontrar los componentes indicados.</p></div><a class="secondary-button" href="mailto:ventas@compumundo.com">Consultar</a></div></section>
<div class="modal fade" id="product-modal" tabindex="-1" aria-labelledby="modal-product-name" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content product-modal-content"><button type="button" class="btn-close modal-close" data-bs-dismiss="modal" aria-label="Cerrar"></button><div class="product-modal-icon" id="modal-product-icon">💻</div><div><p class="eyebrow" id="modal-product-brand"></p><h2 id="modal-product-name"></h2><p id="modal-product-description"></p><p class="modal-stock" id="modal-product-stock"></p><div class="modal-bottom"><strong id="modal-product-price"></strong><button class="primary-button" id="modal-add-button" type="button">Agregar al carrito</button></div></div></div></div></div>
@section Scripts { <script src="~/js/catalogo.js" asp-append-version="true"></script> }
