@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tienda de Computación - Prototipo HTML</title>
    <style>
        body { font-family: Arial, sans-serif; background-color: #b0b0b0; /* Color de fondo gris para coincidir con la imagen */ color: #000; margin: 0; }
        header { background-color: #dcdcdc; padding: 10px 20px; display: flex; align-items: center; justify-content: space-between; }
        .logo { background-color: #fff; font-size: 24px; font-weight: bold; border-radius: 10px; padding: 15px 40px; cursor: pointer; }
        .header-controls { display: flex; align-items: center; gap: 20px; }
        .search-bar input { background-color: #666; color: #fff; border: none; border-radius: 20px; padding: 10px 20px; width: 300px;}
        .user-controls { font-weight: bold; display: flex; align-items: center; gap: 10px; cursor: pointer; }
        .cart-icon { width: 30px; height: 30px; font-size: 24px; cursor: pointer; }

        main { padding: 20px; }
        h1, h2 { text-align: center; }

        /* Categorías principales */
        .categories-nav { display: flex; justify-content: center; gap: 20px; margin-bottom: 30px; }
        .categories-nav button { background-color: #fff; color: #000; border: none; padding: 10px 20px; cursor: pointer; font-weight: bold; }

        /* Banners de anuncios */
        .ads-container { display: flex; justify-content: center; gap: 20px; margin-bottom: 40px; }
        /* Añadido cursor pointer para indicar que es clickeable */
        .ad-banner { background-color: #fff; color: #000; text-align: center; padding: 150px; border-radius: 20px; width: 100%; max-width: 300px; cursor: pointer; transition: transform 0.2s;}
        .ad-banner:hover { transform: scale(1.02); }
        .ad-banner h3 { margin: 0; font-size: 32px; }

        /* Tarjetas de productos */
        .product-grid { display: flex; flex-wrap: wrap; gap: 20px; justify-content: center; }
        .product-card { background-color: #fff; border-radius: 20px; padding: 15px; width: 250px; text-align: center; }
        .product-card .image-placeholder { background-color: #eee; color: #000; padding: 50px; margin-bottom: 10px; border-radius: 10px; font-weight: bold; }
        .add-to-cart { background-color: #8fa5ff; color: #000; border: none; padding: 10px 20px; margin-top: 10px; cursor: pointer; border-radius: 20px; font-weight: bold; }

        /* NUEVO: Detalles de producto (basado en image_307f46.png) */
        .detail-layout { display: flex; gap: 40px; max-width: 1000px; margin: 0 auto; }
        .detail-left { flex: 1; }
        .detail-main-img { background-color: #fff; height: 400px; border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 48px; font-weight: bold; transform: rotate(0deg); margin-bottom: 20px; }
        .detail-thumbnails { display: flex; justify-content: space-between; gap: 10px; }
        .detail-thumb { background-color: #fff; width: 100px; height: 100px; border-radius: 20px; display: flex; align-items: center; justify-content: center; font-weight: bold; transform: rotate(deg); }
        .detail-right { flex: 1; display: flex; flex-direction: column; }
        .detail-title { font-size: 32px; margin-top: 0; margin-bottom: 10px; }
        .detail-separator { border-top: 2px dashed #666; margin-bottom: 10px; }
        .detail-price-section { margin-top: 20px; margin-bottom: 20px; }
        .detail-price { font-size: 24px; margin-bottom: 15px; }
        .detail-specs { background-color: #fff; border-radius: 20px; padding: 20px; flex-grow: 1; margin-top: 20px; }
    </style>
</head>
<body>

<header>
    <!-- Al clickear el logo volvemos al inicio -->
    <div class="logo" onclick="mostrarVista('landing-page')">Logo</div>
    <div class="header-controls">
        <div class="search-bar">
            <input type="text" placeholder="Buscar">
        </div>
        <div class="user-controls">👤 Ingresar</div>
        <div class="cart-icon">🛒</div>
    </div>
</header>

<main>
    <nav class="categories-nav">
        <button onclick="mostrarVista('landing-page')">Inicio</button>
        <button>Productos</button>
        <button>Arma tu PC</button>
        <button>Pc Pre-armadas</button>
        <button>Quienes somos?</button>
    </nav>

    <!-- VISTA INICIO -->
    <section id="landing-page">
        <div class="ads-container">
            <!-- Banners clickeables que dirigen al detalle del producto -->
            <div class="ad-banner" onclick="mostrarVista('product-detail-view')">
                <h3>[Anuncio 1]</h3>
            </div>
            <div class="ad-banner" onclick="mostrarVista('product-detail-view')">
                <h3>[Anuncio 2]</h3>
            </div>
            <div class="ad-banner" onclick="mostrarVista('product-detail-view')">
                <h3>[Anuncio 3]</h3>
            </div>
        </div>

        <h2>Productos destacados</h2>
        <div class="product-grid">
            <div class="product-card" onclick="mostrarVista('product-detail-view')" style="cursor:pointer;">
                <div class="image-placeholder">FOTO</div>
                <h3>Producto Ejemplo</h3>
                <p>$ 15.000</p>
                <button class="add-to-cart">Sumar al carrito</button>
            </div>
        </div>
    </section>

    <!-- NUEVA VISTA: DETALLE DE PRODUCTO (Oculta por defecto) -->
    <section id="product-detail-view" style="display: none;">
        <div class="detail-layout">
            
            <div class="detail-left">
                <div class="detail-main-img">PRODUCTO</div>
                <div class="detail-thumbnails">
                    <div class="detail-thumb">FOTO</div>
                    <div class="detail-thumb">FOTO</div>
                    <div class="detail-thumb">FOTO</div>
                    <div class="detail-thumb">FOTO</div>
                </div>
            </div>

            <div class="detail-right">
                <h2 class="detail-title">Nombre del producto</h2>
                <div class="detail-separator"></div>
                <div class="detail-separator"></div>
                
                <div class="detail-price-section">
                    <div class="detail-price">Precio del producto-------------</div>
                    <button class="add-to-cart">Sumar al carrito</button>
                </div>

                <div class="detail-specs">
                    <h3>caracteristicas generales del producto</h3>
                    <p>Aquí se mapearán las propiedades de tu modelo Producto.cs.</p>
                </div>
            </div>

        </div>
    </section>

</main>

<!-- SCRIPT PARA NAVEGACIÓN INTERNA -->
<script>
    function mostrarVista(idVista) {
        // Ocultar todas las vistas principales
        document.getElementById('landing-page').style.display = 'none';
        document.getElementById('product-detail-view').style.display = 'none';
        
        // Mostrar solo la vista solicitada
        document.getElementById(idVista).style.display = 'block';
    }
</script>

</body>
</html>