<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Compumundo</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/administracion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-extra.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tienda.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/configurador.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CompumundoFront.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg site-nav">
            <div class="container">
                <a class="navbar-brand brand" asp-controller="Home" asp-action="Index"><span>COMPU</span>MUNDO</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Abrir menú de navegación"><span class="navbar-toggler-icon"></span></button>
                <div class="navbar-collapse collapse"><ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="productos">Productos</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="armar-pc">Armá tu PC</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="prearmadas">Prearmadas</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="nosotros">Nosotros</a></li>
                    <li class="nav-item"><button class="nav-link account-button" id="account-button" type="button">Ingresar</button></li>
                    <li class="nav-item"><a class="nav-link" id="admin-link" asp-controller="Administracion" asp-action="Index">Administración</a></li>
                    <li class="nav-item"><button class="cart-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#carrito" aria-controls="carrito">🛒 <span id="cart-count">0</span></button></li>
                </ul></div>
            </div>
        </nav>
    </header>
    <main role="main">@RenderBody()</main>
    <div class="offcanvas offcanvas-end" tabindex="-1" id="carrito" aria-labelledby="carrito-titulo"><div class="offcanvas-header"><h2 class="offcanvas-title" id="carrito-titulo">Tu carrito</h2><button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button></div><div class="offcanvas-body"><div id="cart-items"><p class="empty-cart">Todavía no agregaste productos.</p></div><div class="cart-summary"><strong>Total: <span id="cart-total">$0</span></strong><button class="primary-button full-button" type="button" id="checkout-button">Finalizar compra</button></div></div></div>
    <div class="modal fade" id="admin-login-modal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content form-modal"><div class="modal-header"><div><p class="eyebrow">ACCESO INTERNO</p><h2>Administración</h2></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><form id="admin-login-form"><div class="modal-body"><label>Código de administrador<input name="codigoAdmin" required></label><label>Contraseña<input name="contrasenia" type="password" required></label><p class="form-message" id="admin-login-message"></p></div><div class="modal-footer"><button class="primary-button" type="submit">Ingresar</button></div></form></div></div></div>
    <footer class="site-footer"><div class="container footer-content"><a class="brand" asp-controller="Home" asp-action="Index"><span>COMPU</span>MUNDO</a><p>Tu tienda de tecnología, simple y cerca.</p></div></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script><script src="~/js/admin-access.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
